# ─────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://podforge:podforge@localhost:5432/podforge
DATABASE_SYNC_URL=postgresql+psycopg2://podforge:podforge@localhost:5432/podforge

# ─────────────────────────────────────────────
# Redis
# ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─────────────────────────────────────────────
# Qdrant
# ─────────────────────────────────────────────
QDRANT_URL=http://localhost:6333

# ─────────────────────────────────────────────
# MinIO / S3
# ─────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=podforge

# ─────────────────────────────────────────────
# Auth
# ─────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ─────────────────────────────────────────────
# App
# ─────────────────────────────────────────────
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO

# ─────────────────────────────────────────────
# LLMs (needed from Phase 3)
# ─────────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ─────────────────────────────────────────────
# Research (needed from Phase 2 MCP)
# ─────────────────────────────────────────────
TAVILY_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
YOUTUBE_API_KEY=
NEWSAPI_KEY=

# ─────────────────────────────────────────────
# Audio (needed from Phase 2 MCP)
# ─────────────────────────────────────────────
ELEVENLABS_API_KEY=

# ─────────────────────────────────────────────
# Publishing (optional in dev)
# ─────────────────────────────────────────────
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
YOUTUBE_OAUTH_TOKEN=

# ─────────────────────────────────────────────
# Observability
# ─────────────────────────────────────────────
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=podforge-dev
SENTRY_DSN=
